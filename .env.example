# Frontend Environment Configuration
# Use local relative paths so requests go through Vite's dev server proxy to avoid CORS errors:
VITE_API_BASE_URL=/api/v1
VITE_WS_URL=

# Backend target URL for Vite proxy (configured in vite.config.ts)
VITE_BACKEND_URL=https://107.23.154.150.sslip.io

# Local Development Backend (if running backend locally on port 3000)
# VITE_BACKEND_URL=http://localhost:3000
